# Analysis Engine: auto | rules | openai
ANALYSIS_ENGINE=auto

# OpenAI configuration (required if ANALYSIS_ENGINE=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000

# CORS: Set to your frontend URL (e.g. https://your-frontend.vercel.app), or leave blank for '*'
ALLOWED_ORIGIN=

# Limits
PORT=3000
HOST=0.0.0.0
MAX_TEXT_CHARS=60000
MAX_BODY_BYTES=262144
MAX_POLICY_CHARS=20000
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX=30
